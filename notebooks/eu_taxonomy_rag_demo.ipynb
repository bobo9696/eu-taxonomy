    "import nest_asyncio\n",
    "nest_asyncio.apply()\n",
    "\n",
    "import asyncio\n",
    "from rag.evaluate import evaluate_rag\n",
    "\n",
    "def run_eval(rag_type=\"classic\", prompt_type=\"intermediate\", use_rerank=False):\n",
    "    loop = asyncio.new_event_loop()\n",
    "    asyncio.set_event_loop(loop)\n",
    "    try:\n",
    "        return loop.run_until_complete(\n",
    "            evaluate_rag(rag_type=rag_type, prompt_type=prompt_type, use_rerank=use_rerank)\n",
    "        )\n",
    "    finally:\n",
    "        loop.close()\n",
    "\n",
    "result = run_eval(rag_type=\"classic\", prompt_type=\"intermediate\", use_rerank=False)\n",
    "\n",
    "print(f\"✅ Configuration : {result['rag_type']} / {result['prompt_type']} / rerank={result['use_rerank']}\")\n",
    "print(\"\\n📊 Métriques agrégées :\")\n",
    "for metric, value in result[\"metrics\"].items():\n",
    "    print(f\"  {metric:<22}: {value}\")"
   ]
